<Window x:Class="DiskCleaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiskCleaner.App.Views"
        Title="DiskCleaner — análise de espaço em disco" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="16">
    <!-- Drives + actions -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Discos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Drives}" IsEnabled="{Binding AnalyzeCommand.CanExecute, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,10" Width="240">
              <StackPanel>
                <CheckBox IsChecked="{Binding IsSelected}" FontWeight="SemiBold" Content="{Binding Title}" />
                <ProgressBar Height="8" Margin="0,8,0,4" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" />
                <TextBlock Text="{Binding SpaceText}" Foreground="{StaticResource Muted}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
        <Button Content="Analisar" Command="{Binding AnalyzeCommand}" IsDefault="True" />
        <Button Content="Cancelar" Command="{Binding CancelCommand}" />
        <Button Content="Configurações" Click="OnSettingsClick" />
      </StackPanel>
      <ProgressBar Height="4" IsIndeterminate="{Binding IsScanning}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
      <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
      <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap" />
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Mapa de espaço">
        <views:MapView DataContext="{Binding Map}" />
      </TabItem>
      <TabItem Header="Sugestões de limpeza">
        <views:SuggestionsView DataContext="{Binding Suggestions}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
