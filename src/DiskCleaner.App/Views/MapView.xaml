<UserControl x:Class="DiskCleaner.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskCleaner.App.ViewModels"
             xmlns:views="clr-namespace:DiskCleaner.App.Views">
  <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*" MinWidth="320" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="6*" MinWidth="240" />
    </Grid.ColumnDefinitions>

    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
>
      <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          <Setter Property="ContextMenu">
            <Setter.Value>
              <ContextMenu>
                <MenuItem Header="Abrir no Explorer" Command="{Binding OpenInExplorerCommand}" />
                <MenuItem Header="Mandar para a Lixeira…" Command="{Binding RecycleCommand}" />
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
          <Grid ToolTip="{Binding Node.FullPath}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" />
            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" />
              <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource Muted}" />
            </TextBlock>
            <ProgressBar Grid.Column="2" Height="8" Margin="4,0" Minimum="0" Maximum="1" Value="{Binding PercentOfParent, Mode=OneWay}" />
            <TextBlock Grid.Column="3" Text="{Binding SizeText}" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Text="{Binding PercentText}" TextAlignment="Right" Foreground="{StaticResource Muted}" />
          </Grid>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button DockPanel.Dock="Left" Content="↑ Subir" Command="{Binding GoUpCommand}" MinWidth="70" />
        <TextBlock Text="{Binding CurrentPathText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                 Text="Clique numa pasta para entrar nela; clique num arquivo para selecioná-lo na árvore." />
      <Border BorderBrush="#D1D5DB" BorderThickness="1">
        <views:TreemapControl x:Name="Treemap" Node="{Binding TreemapNode}" Version="{Binding Version}"
                              NodeClicked="OnTreemapNodeClicked" />
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
