<Window x:Class="DiskCleaner.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="16">
    <TextBlock Text="Arquivo grande a partir de (MB)" />
    <TextBox x:Name="LargeFileMb" Margin="0,4,0,12" />
    <TextBlock Text="Downloads antigos: mais de (dias)" />
    <TextBox x:Name="OldDownloadDays" Margin="0,4,0,12" />
    <TextBlock Text="Regras ativas" FontWeight="SemiBold" Margin="0,4,0,4" />
    <ItemsControl x:Name="Rules">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" Margin="0,2" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="Error" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Salvar" IsDefault="True" Click="OnSave" />
      <Button Content="Cancelar" IsCancel="True" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
