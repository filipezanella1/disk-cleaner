<Application x:Class="DiskCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Muted" Color="#6B7280" />
    <SolidColorBrush x:Key="SafeBrush" Color="#15803D" />
    <SolidColorBrush x:Key="ReviewBrush" Color="#B45309" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
  </Application.Resources>
</Application>
